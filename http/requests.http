@baseUrl = http://localhost:8080

### Register a user
< {% client.global.set("email", "user" + Date.now() + "@example.com"); %}
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "password123",
  "fullName": "Ivan Petrov"
}

### Log in
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "password123"
}

> {% client.global.set("token", response.body.accessToken); %}

### Log in with a wrong password -> 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "wrong-password"
}

### Register with invalid data -> 400 with fieldErrors
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "short",
  "fullName": ""
}

### Current user
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}

### Change full name
PATCH {{baseUrl}}/api/users/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "fullName": "Ivan Sidorov"
}

### Request without a token -> 401
GET {{baseUrl}}/api/users/me

### Admin endpoint as a regular user -> 403
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{token}}

### Log in as admin (credentials from application.yml, local only)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@minibank.local",
  "password": "admin12345"
}

> {% client.global.set("adminToken", response.body.accessToken); %}

### All users (admin only)
GET {{baseUrl}}/api/admin/users
Authorization: Bearer {{adminToken}}

### Open an account
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency": "RUB"
}

> {% client.global.set("accountId", response.body.id); %}

### Open an account with unsupported currency -> 400
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency": "GBP"
}

### My accounts
GET {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}

### My account by id
GET {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{token}}

### Someone else's account (admin does not own it) -> 404
GET {{baseUrl}}/api/accounts/{{accountId}}
Authorization: Bearer {{adminToken}}

### Deposit
< {% client.global.set("depositKey", $random.uuid); %}
POST {{baseUrl}}/api/accounts/{{accountId}}/deposit
Authorization: Bearer {{token}}
Idempotency-Key: {{depositKey}}
Content-Type: application/json

{
  "amount": 1000.00,
  "description": "Salary"
}

### Repeat the same deposit (same key) -> same transaction, balance changes only once
POST {{baseUrl}}/api/accounts/{{accountId}}/deposit
Authorization: Bearer {{token}}
Idempotency-Key: {{depositKey}}
Content-Type: application/json

{
  "amount": 1000.00,
  "description": "Salary"
}

### Deposit with three decimal places -> 400
POST {{baseUrl}}/api/accounts/{{accountId}}/deposit
Authorization: Bearer {{token}}
Idempotency-Key: {{$random.uuid}}
Content-Type: application/json

{
  "amount": 10.555
}

### Second account to transfer to
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency": "RUB"
}

> {% client.global.set("secondAccountNumber", response.body.accountNumber); %}

### Transfer
POST {{baseUrl}}/api/transfers
Authorization: Bearer {{token}}
Idempotency-Key: {{$random.uuid}}
Content-Type: application/json

{
  "fromAccountId": {{accountId}},
  "toAccountNumber": "{{secondAccountNumber}}",
  "amount": 250.50,
  "category": "GROCERIES",
  "description": "Weekly shopping"
}

### Transfer more than the balance -> 422
POST {{baseUrl}}/api/transfers
Authorization: Bearer {{token}}
Idempotency-Key: {{$random.uuid}}
Content-Type: application/json

{
  "fromAccountId": {{accountId}},
  "toAccountNumber": "{{secondAccountNumber}}",
  "amount": 1000000.00
}

### Close an account with money -> 422
POST {{baseUrl}}/api/accounts/{{accountId}}/close
Authorization: Bearer {{token}}

### Open an empty account to close it
POST {{baseUrl}}/api/accounts
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currency": "EUR"
}

> {% client.global.set("emptyAccountId", response.body.id); %}

### Close the empty account
POST {{baseUrl}}/api/accounts/{{emptyAccountId}}/close
Authorization: Bearer {{token}}

### Close it again -> 422
POST {{baseUrl}}/api/accounts/{{emptyAccountId}}/close
Authorization: Bearer {{token}}
